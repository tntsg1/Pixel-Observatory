{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pixel-observatory-web",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-07-19",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "pixelobservatorygame.com",
      "custom_domain": true
    }
  ],
  "r2_buckets": [
    {
      "binding": "GAME_ASSETS",
      "bucket_name": "pixel-observatory-game-assets"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pixel-observatory",
      "database_id": "9a40a4cb-7416-4349-83b7-eafb4b9cac88",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "TURNSTILE_SITE_KEY": "0x4AAAAAAD_rkcP9V8E93XKT"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "VISITOR_COUNTER",
        "class_name": "VisitorCounter"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["VisitorCounter"]
    }
  ],
  "assets": {
    "directory": "./build/cloudflare-public",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
