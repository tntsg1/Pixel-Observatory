# Normalize EOL for all files that Git considers text files.
* text=auto eol=lf

# Pixel Observatory game textures stored in Git LFS.
assets/**/*.png filter=lfs diff=lfs merge=lfs -text
assets/fonts/*.ttf filter=lfs diff=lfs merge=lfs -text
assets/audio/music/*.mp3 filter=lfs diff=lfs merge=lfs -text

# These current Godot release assets stay in regular Git while the repository's
# LFS allocation is exhausted. Each file remains below GitHub's 100 MB limit.
assets/reference/observatory_occluders/*.png -filter -diff -merge -text
assets/reference/observatory_room_hall_*.png -filter -diff -merge -text
assets/telescope_view/official/*.png -filter -diff -merge -text
assets/assembly/fast_blueprint_center_cropped.png -filter -diff -merge -text
assets/assembly/fast_blueprint_reference.png -filter -diff -merge -text
assets/learning_media/heritage/naked_eye_observation_scene.png -filter -diff -merge -text
assets/main_menu/main_menu_bg_zh_1024.png -filter -diff -merge -text
assets/main_menu/main_menu_bg_zh_source.png -filter -diff -merge -text
assets/reference/observatory_furniture/remote_instrument_desk_official.png -filter -diff -merge -text
assets/characters/player_observer_smooth_8dir.png -filter -diff -merge -text
assets/fonts/*.ttf -filter -diff -merge -text
assets/audio/music/*.mp3 -filter -diff -merge -text

